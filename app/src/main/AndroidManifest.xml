<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VehicleEqualizerApp"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Aqui sim vai o Service -->
        <service
            android:name=".EqualizerService"
            android:enabled="true"
            android:exported="false" >
            <!-- Só adicione um intent-filter se o service precisar responder a intents explícitas -->
            <!--
            <intent-filter>
                <action android:name="com.senai.vehicleequalizerapp.action.BIND_EQUALIZER_SERVICE" />
            </intent-filter>
            -->
        </service>

    </application>

</manifest>
